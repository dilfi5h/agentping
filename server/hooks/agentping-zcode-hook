#!/usr/bin/env bash
# AgentPing ZCode hook wrapper (macOS bash 3.2 / Linux / Windows Git Bash). stdin = Claude-compatible JSON.
# Maps: UserPromptSubmit→started, Stop→finished, PermissionRequest→waiting.
# Always exit 0; never print JSON to stdout (ZCode validates hook output strictly).
# Portable: no `mapfile` (bash 4+ only); parse backend = jq → python3/python (external parse helper).
set -u
if [ -n "${AGENTPING_NOTIFY:-}" ]; then
  NOTIFY="$AGENTPING_NOTIFY"
else
  NOTIFY=""
  for _p in "$HOME/bin/agent-notify" /usr/local/bin/agent-notify /opt/homebrew/bin/agent-notify; do
    if [ -x "$_p" ]; then NOTIFY="$_p"; break; fi
  done
  [ -n "$NOTIFY" ] || NOTIFY="agent-notify"
fi
SELF_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd || true)
PARSE_PY="${AGENTPING_HOOK_PARSE:-}"
if [ -z "$PARSE_PY" ] && [ -n "$SELF_DIR" ] && [ -f "$SELF_DIR/agentping-zcode-hook-parse.py" ]; then
  PARSE_PY="$SELF_DIR/agentping-zcode-hook-parse.py"
fi
if [ -z "$PARSE_PY" ]; then
  PARSE_PY="$HOME/bin/agentping-zcode-hook-parse.py"
fi
# Append system paths rather than prepending: on macOS, Homebrew jq/python3 must rank ahead of the Xcode stub
export PATH="$PATH:/usr/bin:/mingw64/bin:/bin"
export PYTHONIOENCODING=utf-8
export PYTHONUTF8=1

dbg() {
  [ "${AGENTPING_DEBUG:-}" = "1" ] || return 0
  mkdir -p "$HOME/.agentping-debug" 2>/dev/null || true
  printf '%s %s\n' "$(date -Iseconds 2>/dev/null || date)" "$*" >>"$HOME/.agentping-debug/zcode-hook.log" 2>/dev/null || true
}
dbg "hook_enter"

json="$(cat || true)"
[ -n "$json" ] || { dbg "empty_stdin"; exit 0; }

parse() {
  if command -v jq >/dev/null 2>&1; then
    # One line per field; flatten CR/LF inside values; cap long summaries (keep the hook fast).
    printf '%s' "$json" | jq -r '
      [
        ((.hook_event_name // .hookEventName // "") | tostring),
        ((.session_id // .sessionId // "") | tostring),
        ((.prompt // "") | tostring),
        (((.responsePreview // .last_assistant_message // .responseText // "") | tostring | .[0:500])),
        ((.tool_name // .toolName // "") | tostring),
        (((.tool_input // .toolInput // "") | if type=="string" then . else tostring end | .[0:500])),
        (((.reason // "") | tostring | .[0:200]))
      ]
      | map(tostring | gsub("\r";" ") | gsub("\n";" "))
      | .[]
    ' 2>/dev/null
    return
  fi
  PYBIN=""
  if command -v python3 >/dev/null 2>&1; then PYBIN=python3
  elif command -v python >/dev/null 2>&1; then PYBIN=python; fi
  [ -n "$PYBIN" ] || return 1
  if [ -n "$PARSE_PY" ] && [ -f "$PARSE_PY" ]; then
    printf '%s' "$json" | PYTHONIOENCODING=utf-8 "$PYBIN" "$PARSE_PY"
    return
  fi
  dbg "missing_parse_py"
  return 1
}

# bash 3.2 compatibility: mapfile is bash 4+; read into an array line by line instead
F=()
while IFS= read -r _l || [ -n "$_l" ]; do
  F+=("$_l")
done < <(parse)
EVENT=$(printf "%s" "${F[0]:-}" | tr -d '\r')
SESSION=$(printf "%s" "${F[1]:-}" | tr -d '\r')
PROMPT=$(printf "%s" "${F[2]:-}" | tr -d '\r')
RESP=$(printf "%s" "${F[3]:-}" | tr -d '\r')
TOOL=$(printf "%s" "${F[4]:-}" | tr -d '\r')
TOOL_INPUT=$(printf "%s" "${F[5]:-}" | tr -d '\r')
REASON=$(printf "%s" "${F[6]:-}" | tr -d '\r')

[ -n "$EVENT" ] || { dbg "empty_event"; exit 0; }

onespace() { printf "%s" "$1" | tr '\r\n\t' '   ' | sed 's/  */ /g; s/^ *//; s/ *$//'; }
PROMPT=$(onespace "$PROMPT")
RESP=$(onespace "$RESP")
TOOL=$(onespace "$TOOL")
TOOL_INPUT=$(onespace "$TOOL_INPUT")
REASON=$(onespace "$REASON")

dbg "event=$EVENT session=$SESSION"

case "$EVENT" in
  UserPromptSubmit|SessionStart)
    TASK="${PROMPT:-session start}"
    dbg "send started"
    "$NOTIFY" started --agent zcode --task "${TASK:0:80}" ${SESSION:+--session "$SESSION"} >/dev/null 2>&1 || true
    ;;
  Stop)
    TASK="$PROMPT"
    [ -n "$TASK" ] || TASK="$RESP"
    [ -n "$TASK" ] || TASK="zcode session"
    dbg "send finished"
    "$NOTIFY" finished --agent zcode --task "${TASK:0:80}" ${SESSION:+--session "$SESSION"} >/dev/null 2>&1 || true
    ;;
  PermissionRequest)
    DETAIL="$TOOL"
    [ -n "$TOOL_INPUT" ] && DETAIL="${DETAIL:+$DETAIL }${TOOL_INPUT}"
    [ -n "$REASON" ] && DETAIL="${DETAIL:+$DETAIL | }$REASON"
    [ -n "$DETAIL" ] || DETAIL="permission requested"
    TASK="${PROMPT:-permission}"
    dbg "send waiting"
    "$NOTIFY" waiting --agent zcode --task "${TASK:0:80}" --detail "${DETAIL:0:500}" ${SESSION:+--session "$SESSION"} >/dev/null 2>&1 || true
    ;;
  *)
    dbg "unhandled_event=$EVENT"
    ;;
esac
exit 0
