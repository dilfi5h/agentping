#!/usr/bin/env bash
# agent-notify — AgentPing reporter v1 (DESIGN.md §3.5)
# Usage: agent-notify <started|finished|failed|waiting> [options]
#   --agent <name>   defaults to shell
#   --host <name>    defaults to hostname -s
#   --task <text>    summary (≤80 chars)
#   --detail <text>  extra info (≤500 chars)
#   --session <id>
#   --dur <ms>
# Config sources (priority): env vars AGENTPING_URL / AGENTPING_TOKEN / AGENTPING_DEBOUNCE_SEC
#   > /etc/agentping.conf > ~/.agentping.conf
# Debounce (finished/waiting): same session (or host+agent if no session) waits
#   AGENTPING_DEBOUNCE_SEC seconds (default 180) then publishes one merged notice;
#   metadata from the first event; subsequent task/detail text appended into detail.
#   failed publishes immediately and clears pending. Set AGENTPING_DEBOUNCE_SEC=0 to disable.
# Behavior contract: any internal error → one stderr line + exit 0; never blocks, never changes the agent's exit code

STATE="${1:-}"; shift 2>/dev/null || true
AGENT="shell"
HOST="${AGENTPING_HOST:-}"
if [ -z "$HOST" ]; then HOST=$(hostname -s 2>/dev/null || true); fi
if [ -z "$HOST" ]; then HOST=$(hostname 2>/dev/null || true); fi
if [ -z "$HOST" ]; then HOST="${COMPUTERNAME:-unknown}"; fi
HOST="${HOST%%.*}"
TASK=""; DETAIL=""; SESSION=""; DUR=""

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)   AGENT="$2";   shift 2 ;;
    --host)    HOST="$2";    shift 2 ;;
    --task)    TASK="$2";    shift 2 ;;
    --detail)  DETAIL="$2";  shift 2 ;;
    --session) SESSION="$2"; shift 2 ;;
    --dur)     DUR="$2";     shift 2 ;;
    *)         shift ;;
  esac
done

[ -n "$STATE" ] || { echo "agent-notify: missing state" >&2; exit 0; }
case "$STATE" in started|finished|failed|waiting) ;; *) echo "agent-notify: bad state '$STATE'" >&2; exit 0 ;; esac

# started is frequent and carries no action value: CLI/hooks may still pass it, it's valid but not published (exit 0)
[ "$STATE" = "started" ] && exit 0

if [ -z "$AGENTPING_URL" ] || [ -z "$AGENTPING_TOKEN" ]; then
  if [ -f /etc/agentping.conf ]; then
    . /etc/agentping.conf
  elif [ -f "$HOME/.agentping.conf" ]; then
    . "$HOME/.agentping.conf"
  fi
fi
[ -n "$AGENTPING_URL" ]   || { echo "agent-notify: no AGENTPING_URL" >&2; exit 0; }
[ -n "$AGENTPING_TOKEN" ] || { echo "agent-notify: no AGENTPING_TOKEN" >&2; exit 0; }

# Priority/emoji mapping (§3.3); started was already swallowed above
case "$STATE" in
  finished) PRIO_N=3; TAGS="robot,white_check_mark" ;;
  failed)   PRIO_N=4; TAGS="robot,x" ;;
  waiting)  PRIO_N=4; TAGS="robot,hourglass_flowing_sand" ;;
esac

# Clip in the shell so env vars stay short; publisher also clips.
clip() { printf '%s' "${1:0:$2}"; }
HOST=$(clip "$HOST" 64)
AGENT=$(clip "$AGENT" 32)
TASK=$(clip "$TASK" 80)
DETAIL=$(clip "$DETAIL" 500)
SESSION=$(clip "$SESSION" 64)
case "$DUR" in
  ''|*[!0-9]*) DUR="" ;;
esac

# BODY_PY: env > same-dir as this script > ~/bin > /usr/local/bin
SELF_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd || true)
BODY_PY="${AGENTPING_BODY_PY:-}"
if [ -z "$BODY_PY" ] && [ -n "$SELF_DIR" ] && [ -f "$SELF_DIR/agentping-ntfy-body.py" ]; then
  BODY_PY="$SELF_DIR/agentping-ntfy-body.py"
fi
if [ -z "$BODY_PY" ] && [ -f "$HOME/bin/agentping-ntfy-body.py" ]; then
  BODY_PY="$HOME/bin/agentping-ntfy-body.py"
fi
if [ -z "$BODY_PY" ] && [ -f /usr/local/bin/agentping-ntfy-body.py ]; then
  BODY_PY=/usr/local/bin/agentping-ntfy-body.py
fi
[ -f "$BODY_PY" ] || { echo "agent-notify: missing agentping-ntfy-body.py" >&2; exit 0; }

PY=python3
command -v python3 >/dev/null 2>&1 || PY=python
command -v "$PY" >/dev/null 2>&1 || { echo "agent-notify: no python3/python" >&2; exit 0; }

export AGENTPING_URL AGENTPING_TOKEN
# Pass through debounce override if set (also readable from conf via the python helper)
[ -n "${AGENTPING_DEBOUNCE_SEC+x}" ] && export AGENTPING_DEBOUNCE_SEC

AP_AGENT="$AGENT" AP_HOST="$HOST" AP_STATE="$STATE" \
AP_TASK="$TASK" AP_DETAIL="$DETAIL" AP_SESSION="$SESSION" AP_DUR="$DUR" \
AP_TAGS="$TAGS" AP_PRIO="$PRIO_N" AP_TOPIC_HOST="agentping-${HOST}" \
"$PY" "$BODY_PY" >/dev/null 2>&1 || true
exit 0
