#!/usr/bin/env bash
# agent-notify — AgentPing reporter v1（DESIGN.md §3.5）
# 用法: agent-notify <started|finished|failed|waiting> [选项]
#   --agent <name>   默认 shell
#   --host <name>    默认 hostname -s
#   --task <text>    摘要（≤80 字符）
#   --detail <text>  补充（≤500 字符）
#   --session <id>
#   --dur <ms>
# 配置来源(优先级): 环境变量 AGENTPING_URL / AGENTPING_TOKEN > /etc/agentping.conf > ~/.agentping.conf
# 行为约束: 任何自身错误 → stderr 一行 + exit 0；永不阻塞、永不影响 agent 退出码

STATE="${1:-}"; shift 2>/dev/null || true
AGENT="shell"
HOST="${AGENTPING_HOST:-}"
if [ -z "$HOST" ]; then HOST=$(hostname -s 2>/dev/null || true); fi
if [ -z "$HOST" ]; then HOST=$(hostname 2>/dev/null || true); fi
if [ -z "$HOST" ]; then HOST="${COMPUTERNAME:-unknown}"; fi
HOST="${HOST%%.*}"
TASK=""; DETAIL=""; SESSION=""; DUR=""

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)   AGENT="$2";   shift 2 ;;
    --host)    HOST="$2";    shift 2 ;;
    --task)    TASK="$2";    shift 2 ;;
    --detail)  DETAIL="$2";  shift 2 ;;
    --session) SESSION="$2"; shift 2 ;;
    --dur)     DUR="$2";     shift 2 ;;
    *)         shift ;;
  esac
done

[ -n "$STATE" ] || { echo "agent-notify: missing state" >&2; exit 0; }
case "$STATE" in started|finished|failed|waiting) ;; *) echo "agent-notify: bad state '$STATE'" >&2; exit 0 ;; esac

# started 高频无行动价值：CLI/钩子仍可传，合法但不发布（exit 0）
[ "$STATE" = "started" ] && exit 0

if [ -z "$AGENTPING_URL" ] || [ -z "$AGENTPING_TOKEN" ]; then
  if [ -f /etc/agentping.conf ]; then
    . /etc/agentping.conf
  elif [ -f "$HOME/.agentping.conf" ]; then
    . "$HOME/.agentping.conf"
  fi
fi
[ -n "$AGENTPING_URL" ]   || { echo "agent-notify: no AGENTPING_URL" >&2; exit 0; }
[ -n "$AGENTPING_TOKEN" ] || { echo "agent-notify: no AGENTPING_TOKEN" >&2; exit 0; }

# 优先级/emoji 映射（§3.3）；started 已在上方吞掉，此处仅 finished/failed/waiting
case "$STATE" in
  finished) PRIO=default; TAGS="robot,white_check_mark";         LABEL="已完成" ;;
  failed)   PRIO=high;    TAGS="robot,x";                        LABEL="失败" ;;
  waiting)  PRIO=high;    TAGS="robot,hourglass_flowing_sand";   LABEL="等待批准" ;;
esac

# 先截断再编码，避免转义后切在 \" 中间。${s:0:n} 在 bash 3.2 可用。
clip() { printf '%s' "${1:0:$2}"; }
HOST=$(clip "$HOST" 64)
AGENT=$(clip "$AGENT" 32)
TASK=$(clip "$TASK" 80)
DETAIL=$(clip "$DETAIL" 500)
SESSION=$(clip "$SESSION" 64)
case "$DUR" in
  ''|*[!0-9]*) DUR="" ;;
esac

TITLE="[${HOST}] ${AGENT} ${LABEL}"

# 单行 JSON：python / jq 优先；都没有才退回手工转义
esc() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/ }"
  s="${s//$'\r'/}"
  printf '%s' "$s"
}

build_json() {
  if command -v python3 >/dev/null 2>&1 || command -v python >/dev/null 2>&1; then
    local py=python3
    command -v python3 >/dev/null 2>&1 || py=python
    AP_AGENT="$AGENT" AP_HOST="$HOST" AP_STATE="$STATE" \
    AP_TASK="$TASK" AP_DETAIL="$DETAIL" AP_SESSION="$SESSION" AP_DUR="$DUR" \
    "$py" -c '
import json, os
f = {"v": 1, "agent": os.environ.get("AP_AGENT", ""), "host": os.environ.get("AP_HOST", ""), "state": os.environ.get("AP_STATE", "")}
for key, env in (("task", "AP_TASK"), ("detail", "AP_DETAIL"), ("session", "AP_SESSION")):
    v = os.environ.get(env, "")
    if v:
        f[key] = v
dur = os.environ.get("AP_DUR", "")
if dur.isdigit():
    f["dur"] = int(dur)
print(json.dumps(f, ensure_ascii=False, separators=(",", ":")))
'
    return
  fi
  if command -v jq >/dev/null 2>&1; then
    jq -nc \
      --arg agent "$AGENT" \
      --arg host "$HOST" \
      --arg state "$STATE" \
      --arg task "$TASK" \
      --arg detail "$DETAIL" \
      --arg session "$SESSION" \
      --arg dur "$DUR" \
      '{v:1,agent:$agent,host:$host,state:$state}
       + (if $task == "" then {} else {task:$task} end)
       + (if $detail == "" then {} else {detail:$detail} end)
       + (if $session == "" then {} else {session:$session} end)
       + (if ($dur | test("^[0-9]+$")) then {dur: ($dur | tonumber)} else {} end)'
    return
  fi
  local json="{\"v\":1,\"agent\":\"$(esc "$AGENT")\",\"host\":\"$(esc "$HOST")\",\"state\":\"$(esc "$STATE")\""
  [ -n "$TASK" ]    && json="${json},\"task\":\"$(esc "$TASK")\""
  [ -n "$DETAIL" ]  && json="${json},\"detail\":\"$(esc "$DETAIL")\""
  [ -n "$SESSION" ] && json="${json},\"session\":\"$(esc "$SESSION")\""
  [ -n "$DUR" ]     && json="${json},\"dur\":${DUR}"
  printf '%s' "${json}}"
}

JSON=$(build_json) || { echo "agent-notify: json encode failed" >&2; exit 0; }
[ -n "$JSON" ] || { echo "agent-notify: empty json" >&2; exit 0; }

# 双写总 topic（§3.3）：agentping-<host> 保留给官方 App，agentping-all 给 AgentPing
for TOPIC in "agentping-${HOST}" "agentping-all"; do
  curl -m 5 -s -o /dev/null \
    -H "Authorization: Bearer ${AGENTPING_TOKEN}" \
    -H "Title: ${TITLE}" \
    -H "Tags: ${TAGS}" \
    -H "Priority: ${PRIO}" \
    -H "Markdown: no" \
    --data-binary "$JSON" \
    "${AGENTPING_URL}/${TOPIC}" || true
done
exit 0
