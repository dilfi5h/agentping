@echo off
REM Win32 launcher for agent-notify (Git Bash required).
REM Used by shells / tools that cannot spawn the bash script directly.
set "BASH=C:\Program Files\Git\bin\bash.exe"
if not exist "%BASH%" set "BASH=C:\Program Files (x86)\Git\bin\bash.exe"
if not exist "%BASH%" set "BASH=bash"
"%BASH%" "%USERPROFILE%\bin\agent-notify" %*
